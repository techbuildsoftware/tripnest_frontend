# Copy to .env and fill in before `npm run build`
VITE_SITE_URL=https://www.tripnest.com
# Lead capture: any form backend that accepts a JSON POST (Formspree, Getform, Make/Zapier webhook, Google Apps Script…)
# If empty, forms fall back to a pre-filled WhatsApp / email message.
VITE_FORM_ENDPOINT=
# Analytics (only loaded after the visitor accepts cookies)
VITE_GA_ID=
VITE_META_PIXEL_ID=
